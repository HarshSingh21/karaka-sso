<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.karaka</groupId>
  <artifactId>karaka-service</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>karaka-service</name>
  <description>Karaka suite backend-for-frontend and ORBIT employee register</description>

  <properties>
    <!-- Java 25 (LTS). Spring Boot 4.x baselines on Java 17 and supports 25. -->
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Pinned rather than inherited: Lombok patches javac internals, so the version has
         to track the JDK. The Boot-managed version can lag a new JDK release. -->
    <lombok.version>1.18.46</lombok.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Browser half (BFF): an OAuth2 *client*. Runs the authorization-code
         flow against Keycloak and keeps the tokens server-side. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>

    <!-- Machine half: a *resource server*, validating Bearer JWTs. A separate
         starter — the client one does not bring it in, which surfaces as
         "package ...oauth2.server.resource.authentication does not exist". -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Spring Boot 4 split the old monolithic auto-configuration into fine-grained modules,
         and RestClient moved out of spring-boot-starter-web into its own starter. Without
         this, RestClient.Builder is simply not a bean and every injection of it fails at
         startup with NoSuchBeanDefinitionException — which is exactly how this surfaced when
         upgrading from 3.5.9. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>

    <!-- Boilerplate removal on models and services. Deliberately NOT used on DTOs: those are
         records, which already give a canonical constructor, accessors, equals and toString.
         provided scope — Lombok is an annotation processor, absent at runtime. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <optional>true</optional>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Boot 4's modularisation moved MockMvc's auto-configuration out of
         spring-boot-starter-test. Without this, @AutoConfigureMockMvc is on the classpath and
         compiles, but contributes no bean — the tests fail at runtime with
         "No qualifying bean of type MockMvc", which reads like a broken test rather than a
         missing dependency. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Applies SecurityMockMvcConfigurers.springSecurity() to the auto-configured MockMvc.
         Without it the filter chain still runs — unauthenticated calls correctly 401 — but
         @WithMockUser's SecurityContext never reaches the request, so EVERY authenticated
         test 401s too. That failure looks like broken authorization rules rather than a
         missing test dependency, which is what makes it worth naming here. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Lombok must be declared explicitly here. Boot 4's parent sets an empty
               annotationProcessorPaths, and an empty list means "no processors at all" —
               Lombok then silently does nothing and every getter call fails to compile. -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <!-- Keeps constructor parameter names in the bytecode so Jackson
                 binds records and DTOs without @JsonProperty on every field. -->
            <arg>-parameters</arg>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
