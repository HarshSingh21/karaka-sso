# Copy to .env and change every value before this leaves a laptop.
# .env is gitignored; .env.example is the committed template.

# --- Postgres (Keycloak's database) ---
POSTGRES_PASSWORD=change-me-postgres

# --- Keycloak admin console (http://localhost:8081/admin) ---
# Only seeded on the first boot against an empty database.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-admin

# --- OAuth2 client secret shared by Keycloak and the Spring BFF ---
# Must match `clients[].secret` for karaka-web in keycloak/realm/karaka-realm.json.
# A BFF is a confidential client: the secret lives only on the server, never
# in the browser. Rotate this in both places together.
KEYCLOAK_CLIENT_SECRET=change-me-client-secret

# --- Realm template substitution (scripts/render-realm.sh) ---
# Generate each with: openssl rand -base64 32
# Avoid '|' and '&' — the substitution uses sed with '|' as its delimiter.
# KARAKA_WEB_SECRET and KEYCLOAK_CLIENT_SECRET must hold the SAME value: Keycloak
# stores it, the service presents it.
KARAKA_WEB_SECRET=change-me-web-secret
KARAKA_API_SECRET=change-me-api-secret
DEMO_USER_PASSWORD=change-me-demo-password
APP_BASE_URL=http://localhost:8080
