# Copy to .env and change every value before this leaves a laptop.
# .env is gitignored; .env.example is the committed template.

# --- Postgres (Keycloak's database) ---
POSTGRES_PASSWORD=change-me-postgres

# --- Keycloak admin console (http://localhost:8081/admin) ---
# Only seeded on the first boot against an empty database.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-admin

# --- OAuth2 client secret shared by Keycloak and the Spring BFF ---
# Must match `clients[].secret` for karaka-web in keycloak/realm/karaka-realm.json.
# A BFF is a confidential client: the secret lives only on the server, never
# in the browser. Rotate this in both places together.
KEYCLOAK_CLIENT_SECRET=change-me-client-secret

# --- Realm template substitution (scripts/render-realm.sh) ---
# Generate each with: openssl rand -base64 32
# Avoid '|' and '&' — the substitution uses sed with '|' as its delimiter.
# KARAKA_WEB_SECRET and KEYCLOAK_CLIENT_SECRET must hold the SAME value: Keycloak
# stores it, the service presents it.
KARAKA_WEB_SECRET=change-me-web-secret
KARAKA_API_SECRET=change-me-api-secret
APP_BASE_URL=http://localhost:8080

# DEMO_USER_PASSWORD must satisfy the realm's password policy:
#   length(12) digits(1) lowerCase(1) upperCase(1) specialChars(1) notUsername passwordHistory(3)
# `openssl rand -base64 18` alone will NOT do — stripping '|&+/=' for the sed substitution
# leaves only alphanumerics, so it can never contain a special character. Use genpw() in
# scripts/azure-deploy.sh, or append a '#Aa9'-style tail by hand.
DEMO_USER_PASSWORD=change-me-Demo1!

# --- Google sign-in (OPTIONAL — the stack runs fine without it) ---
# Leave blank to skip. scripts/local-up.sh calls add-google-idp.sh --if-configured, which
# no-ops when these are empty, so Google is a feature and never a prerequisite.
#
# Create the client at console.cloud.google.com -> Google Auth Platform -> Clients:
#   type            Web application
#   redirect URI    http://localhost:8081/realms/karaka/broker/google/endpoint
# An External app in Testing mode ALSO needs the account listed under Audience -> Test users,
# or sign-in fails with access_denied and no explanation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Any provider scripts/add-social-idp.sh knows follows the same <ALIAS>_CLIENT_ID pattern.
# Redirect URI is always:  <keycloak>/realms/karaka/broker/<alias>/endpoint
# Note the REALM in that URI — the admin console defaults to `master`, and configuring a
# provider there wires it into the admin console instead of Karaka.
#
# TWITTER: gives Keycloak NO email address (OAuth 1.0a; X gates email behind elevated
# permission), and this realm requires email — so every Twitter user must type one on the
# review-profile page and verify it. That needs SMTP configured, or they are stranded.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# GITHUB: supplies an email only when the account has a public one.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Empty = any Google account may sign in. Correct for local testing with a @gmail.com
# account; set it to your Workspace domain in any shared deployment, because brokered
# accounts are created by the login flow and `registrationAllowed: false` does NOT stop them.
GOOGLE_HOSTED_DOMAIN=

# --- SMTP (OPTIONAL, but REQUIRED for "Forgot Password?" to work) ---
# resetPasswordAllowed is true, so the login page shows the link. Without SMTP the link
# renders and then throws EmailException on submit — enable one or the other, not a link
# that dead-ends. scripts/set-smtp.sh --if-configured no-ops when these are blank.
#
# Gmail/Workspace: use an APP PASSWORD (needs 2FA), host smtp.gmail.com port 587.
# Brevo/SendGrid/Mailgun free tiers give better deliverability and a real sender domain.
#   ./scripts/set-smtp.sh --test you@example.com    # configure and send a real message
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_NAME=Karaka
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
