# Secrets — the committed template is .env.example
.env

# Maven
service/target/

# IDE
.idea/
*.iml
.vscode/

# macOS
.DS_Store

# Rendered from karaka-realm.template.json by scripts/render-realm.sh.
# Contains real secrets; the template is what belongs in git.
# Keycloak's --import-realm reads EVERY *.json here, so the template must live
# outside it (keycloak/realm-template/) or Keycloak tries to import the
# placeholders and fails with "redirect URI is not a valid URI".
keycloak/realm/*.json

# Generated by scripts/azure-deploy.sh — real secrets, never commit
.azure-secrets

# Written by scripts/local-up.sh so a re-run can stop the service it started.
.local-service.pid
